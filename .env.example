# PetLand Bot — Environment Variables

BOT_TOKEN=your_bale_bot_token
DATABASE_URL=postgresql://user:pass@host:5432/dbname
PORT=3000

# Admin Bale user IDs (comma separated)
ADMIN_BALE_IDS=123456789

# Colleague wholesale access code
COLLEAGUE_ACCESS_CODE=petland1404

# Access code to unlock marketing and wallet features
MARKETING_ACCESS_CODE=petland-vip

# Default profit percent on cost price
DEFAULT_PROFIT_PERCENT=15

# Minimum wholesale order (Toman)
WHOLESALE_MIN_ORDER=50000000

SHOP_NAME=پت لند

# Bank info for manual payment
BANK_CARD=
BANK_IBAN=IR000000000000000000000000
BANK_HOLDER=
BANK_NAME=

# Bot username (without @) — used for referral deep links
BOT_USERNAME=your_bot_username

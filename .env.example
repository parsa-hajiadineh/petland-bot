# Required
BOT_TOKEN=your_bale_bot_token
DATABASE_URL=postgresql://user:password@host:5432/dbname

# HTTP
PORT=3000
PUBLIC_BASE_URL=https://your-domain.example

# Encrypts partner bot tokens at rest. Use a long random string.
BOT_TOKEN_ENCRYPTION_KEY=change-me-to-a-long-random-secret

# Admin Bale user IDs (comma-separated)
ADMIN_BALE_IDS=123456789

# Access codes (set your own values)
COLLEAGUE_ACCESS_CODE=your_colleague_access_code
MARKETING_ACCESS_CODE=your_marketing_access_code

DEFAULT_PROFIT_PERCENT=15
WHOLESALE_MIN_ORDER=0

SHOP_NAME=پائورا

# Bank details for manual payment
BANK_CARD=
BANK_IBAN=
BANK_HOLDER=
BANK_NAME=

# Bot username without @ — used for referral deep links
BOT_USERNAME=your_bot_username
